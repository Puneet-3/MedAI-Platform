# Copy to .env and fill in your own values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Vercel deploys with a 4 MB report limit; local development defaults to 10 MB.
NEXT_PUBLIC_REPORT_MAX_MB="10"
FASTAPI_URL="http://localhost:8080"
# Must match fastapi/.env.
FASTAPI_SECRET=""
# Optional; otherwise chat reuses AUTH_SECRET. The socket server reads this same .env.
SOCKET_SECRET=""
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
ALLOWED_ORIGINS="http://localhost:3000"
# Optional Google sign-in. Both values are needed.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional nearby directory. Maps search works without a key.
GOOGLE_PLACES_API_KEY=""
# Optional private storage. Create a private medical-reports bucket.
# If omitted, reports are stored in frontend/storage/reports on this computer.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
